{
  "name": "db-secure-embed",
  "version": "1.0.0",
  "description": "Secure, allowlist-governed web embed for Qlik Sense (client-managed). Replacement for the legacy Media Box website mode.",
  "type": "module",
  "main": "dist/db-secure-embed.js",
  "scripts": {
    "build": "nebula build --sourcemap false --systemjs false",
    "sense": "nebula sense --ext src/ext.js --meta meta.json --output build/db-secure-embed",
    "package": "npm run build && npm run sense && node scripts/package.mjs",
    "test": "node --test test/*.test.mjs",
    "csp": "node scripts/csp.mjs allowlist.json"
  },
  "author": "DataBridge AG",
  "license": "UNLICENSED",
  "devDependencies": {
    "@nebula.js/cli": "^7.9.0",
    "@nebula.js/cli-build": "^7.9.0",
    "@nebula.js/cli-sense": "^7.9.0",
    "esbuild": "^0.28.2",
    "@nebula.js/stardust": "7.9.0"
  },
  "private": true,
  "files": [
    "dist",
    "db-secure-embed"
  ],
  "peerDependencies": {
    "@nebula.js/stardust": ">=5"
  },
  "engines": {
    "node": ">=24"
  }
}
